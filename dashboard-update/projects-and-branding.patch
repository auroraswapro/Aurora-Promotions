diff --git a/docs/assets/core.css b/docs/assets/core.css
index c70741f..c38f770 100644
--- a/docs/assets/core.css
+++ b/docs/assets/core.css
@@ -1,7 +1,8 @@
 /* Aurora Promotions Dashboard: shared look for every page (top bar, sign-in, home, team). Tool pages add their own styles. */
 :root{
-  --bg:#f3f4f2; --surface:#fcfcfb; --surface-2:#eef0ed; --ink:#14171a; --ink-2:#4f555b; --muted:#80868c;
-  --line:#e0e2dd; --line-strong:#c6c9c2; --accent:#155e63; --accent-ink:#ffffff; --accent-soft:#dcecec;
+  /* Aurora Promotions brand: white with the lavender of the AP logo (#8482a7, deepened for readable buttons) */
+  --bg:#ffffff; --surface:#ffffff; --surface-2:#f3f3f7; --ink:#1d1c2e; --ink-2:#4e4d63; --muted:#7f7e94;
+  --line:#e6e6ee; --line-strong:#cfcfdc; --accent:#625f8f; --accent-ink:#ffffff; --accent-soft:#efeef6; --logo:#8482a7;
   --good-ink:#006300; --good-soft:#e3f3e3; --warn:#b57a00; --warn-soft:#fbf0d6; --crit:#d03b3b; --crit-soft:#fae3e3; --info-ink:#1c5cab; --info-soft:#e2ecf8;
   --f-display:"Bricolage Grotesque","Figtree",system-ui,sans-serif;
   --f-body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
@@ -9,7 +10,7 @@
 }
 @media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
   --bg:#0f1112; --surface:#1a1c1d; --surface-2:#232628; --ink:#f4f5f3; --ink-2:#c3c6c2; --muted:#8d928f;
-  --line:#2c2f30; --line-strong:#3d4143; --accent:#4fb3b3; --accent-ink:#0b1414; --accent-soft:#17312f;
+  --line:#2c2f30; --line-strong:#3d4143; --accent:#aeacd2; --accent-ink:#17162a; --accent-soft:#29283d;
   --good-ink:#3ec43e; --good-soft:#15291a; --warn:#fab219; --warn-soft:#2f2612; --crit:#e66767; --crit-soft:#331b1b; --info-ink:#86b6ef; --info-soft:#15243a;
   color-scheme:dark;
 }}
@@ -22,7 +23,8 @@ button,input,select,textarea{font:inherit;color:inherit}
 /* top bar */
 .ap-bar{background:var(--surface);border-bottom:1px solid var(--line)}
 .ap-bar-in{max-width:1280px;margin:0 auto;padding:8px 20px;display:flex;align-items:center;gap:6px 18px;flex-wrap:wrap}
-.ap-brand{font-family:var(--f-display);font-weight:700;font-size:16px;color:var(--ink);text-decoration:none;white-space:nowrap}
+.ap-brand{font-family:var(--f-display);font-weight:700;font-size:16px;color:var(--ink);text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:9px}
+.ap-brand img{width:32px;height:32px;border-radius:50%;flex:none}
 .ap-brand span{color:var(--accent)}
 .ap-nav{display:flex;gap:2px;flex-wrap:wrap;margin-right:auto}
 .ap-nav a{color:var(--ink-2);text-decoration:none;font-weight:600;padding:5px 10px;border-radius:7px}
@@ -53,6 +55,7 @@ button,input,select,textarea{font:inherit;color:inherit}
 .ap-gate{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;background:var(--bg);overflow:auto}
 .ap-card{max-width:380px;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:24px}
 .ap-card h1{font-family:var(--f-display);font-size:22px;margin:0 0 4px;line-height:1.2}
+.ap-logo{display:block;width:72px;height:72px;border-radius:50%;margin:0 0 14px}
 .ap-card h1 span{color:var(--accent)}
 .ap-card form{display:flex;flex-direction:column;gap:10px;margin-top:4px}
 .ap-card label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600;color:var(--ink-2)}
